]

def remove_border_background(im):
    im = im.convert('RGBA')
    w, h = im.size
    px = im.load()
    # If corners already have true alpha, keep generator transparency.
    corners = [(0,0),(w-1,0),(0,h-1),(w-1,h-1)]
    if all(px[x,y][3] == 0 for x,y in corners):
        return im

    # Flood from the full border through neutral mid-tone pixels. This removes
    # rendered gray checkerboards (including compression/warping variations)
    # while stopping at the saturated pastel or dark-brown icon boundary.
    seen = bytearray(w*h)
    q = deque()
    def bg_candidate(x,y):
        r,g,b,a = px[x,y]
        mx, mn = max(r,g,b), min(r,g,b)
        return a > 0 and (mx-mn) <= 34 and 65 <= (r+g+b)//3 <= 225
    for x in range(w):
        for y in (0,h-1):
            i=y*w+x
            if not seen[i] and bg_candidate(x,y): seen[i]=1; q.append((x,y))
    for y in range(h):
        for x in (0,w-1):
            i=y*w+x
            if not seen[i] and bg_candidate(x,y): seen[i]=1; q.append((x,y))
    while q:
        x,y=q.popleft()
        px[x,y]=(px[x,y][0],px[x,y][1],px[x,y][2],0)
        for nx,ny in ((x-1,y),(x+1,y),(x,y-1),(x,y+1)):
            if 0<=nx<w and 0<=ny<h:
                i=ny*w+nx
                if not seen[i] and bg_candidate(nx,ny):
                    seen[i]=1; q.append((nx,ny))
    return im

for src, dst in items:
    im = remove_border_background(Image.open(src))
    alpha = im.getchannel('A')
    bbox = alpha.getbbox()
    if not bbox:
        raise RuntimeError(f'No visible pixels in {src}')
    im = im.crop(bbox)
    max_dim = max(im.size)
    side = max(512, (max_dim * 100 + 87) // 88)  # visible bbox occupies ~88%; ~6% each side
    canvas = Image.new('RGBA', (side, side), (0,0,0,0))
    x = (side-im.width)//2
    y = (side-im.height)//2
    canvas.alpha_composite(im, (x,y))
    # Enforce fully transparent RGB at canvas corners and validate alpha.
    canvas.save(dst)
    check = Image.open(dst).convert('RGBA')
    assert check.mode == 'RGBA'
    assert all(check.getpixel(p)[3] == 0 for p in [(0,0),(side-1,0),(0,side-1),(side-1,side-1)])
    print(f'{dst}: {check.size} {check.mode}')
